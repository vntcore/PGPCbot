# Copy to .env (never commit it) or set these in your service manager.

# The API host of your PGP Chat server, without /bot/v1. Defaults to the public one.
PGPCHAT_API=https://api.pgpchat.app

# The bot token, shown once in the @bot console. Prefer the _FILE variant in production:
# PGPCHAT_BOT_TOKEN_FILE=/run/secrets/pgpchat_bot_token
PGPCHAT_BOT_TOKEN=

# Only for bots with end-to-end encryption: the private key (armored text or a path)
# and its passphrase. Both also accept the _FILE variant.
# PGPCHAT_BOT_KEY=/etc/weatherbot/bot-key.asc
# PGPCHAT_BOT_KEY_PASSPHRASE_FILE=/run/secrets/bot_key_passphrase

# Only for the webhook examples: the secret the server sends back on every delivery.
# WEBHOOK_SECRET=
